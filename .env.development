# Frontend Environment Configuration

# Google OAuth - REQUIRED FOR LOGIN
# Get from: https://console.cloud.google.com
# This is the PUBLIC client ID from your OAuth 2.0 Web Application
VITE_GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com

# Backend API Configuration - REQUIRED
# Points to your backend server
VITE_API_BASE_URL=http://localhost:3001

# Supabase Configuration (Optional - only if using Supabase)
# Uncomment if you want to use Supabase for persistence
# Get from: https://supabase.com
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Gemini API (Optional - for scam detection AI)
# Get free from: https://makersuite.google.com/app/apikey
# VITE_GEMINI_API_KEY=your-api-key

# Phone.Email (Optional - for phone verification)
# Get free from: https://www.phone.email/auth/sign-up
# VITE_PHONE_EMAIL_CLIENT_ID=your-client-id

# Neon Auth
# Project: SeniorSafe
# Auth URL: https://ep-tiny-dream-anex3lrs.neonauth.c-6.us-east-1.aws.neon.tech/neondb/auth
# JWKS URL: https://ep-tiny-dream-anex3lrs.neonauth.c-6.us-east-1.aws.neon.tech/neondb/auth/.well-known/jwks.json
# Email Provider: auth@mail.myneon.app
VITE_NEON_AUTH_URL=https://ep-tiny-dream-anex3lrs.neonauth.c-6.us-east-1.aws.neon.tech/neondb/auth
