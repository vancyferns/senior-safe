# Backend API Configuration
# The app uses local email/phone authentication (no Google OAuth)
# See neon_migrations/README.md for complete setup instructions

# Public API base URL for the frontend to call
# Example: https://your-api.vercel.app (if deployed on Vercel)
VITE_API_BASE_URL=https://your-api-domain.com

# Server-side Neon Postgres connection string (deploy-only, never expose to browser)
# Get this from https://console.neon.tech after creating a project
# Format: postgresql://user:password@region.neon.tech/database?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_uIGN6XebZji8@ep-little-math-apei2b6l.c-7.us-east-1.aws.neon.tech/neondb?sslmode=require

# SambaNova API Key (for AI-powered scam detection and dynamic scenarios)
# Get your API key from: https://sambanova.ai/
VITE_SAMBANOVA_API_KEY=your-sambanova-api-key

# Phone.Email - FREE Phone Number Verification
# Get your FREE Client ID from: https://www.phone.email/auth/sign-up
# 
# How to get your Client ID:
# 1. Go to https://www.phone.email/auth/sign-up
# 2. Create a free account
# 3. Register your website domain
# 4. Copy the Client ID from the dashboard
#
# Features:
#   - 100% FREE, no credit card required
#   - Works like "Sign in with Google" for phone numbers
#   - Phone.Email handles OTP - no SMS API needed
#   - Global phone number support (200+ countries)
#   - No telecom registration required
VITE_PHONE_EMAIL_CLIENT_ID=your-phone-email-client-id
